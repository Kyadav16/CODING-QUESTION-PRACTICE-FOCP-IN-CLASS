#include <stdio.h>

int main()
{
    int mat[3][3], i, j;
    int sum = 0;

    printf("Enter elements of the 3x3 matrix:\n");
    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            scanf("%d", &mat[i][j]);
        }
    }

    printf("Matrix elements:\n");
    for (i = 0; i < 3; i++)
    {
        for (j = 0; j < 3; j++)
        {
            printf("%d ", mat[i][j]);
        }
        printf("\n");
    }

    // Calculate sum of main diagonal elements
    for (i = 0; i < 3; i++)
    {
        sum += mat[i][i]; // Diagonal elements have the same row and column index
    }

    printf("Sum of diagonal elements: %d\n", sum);
    return 0;
}
